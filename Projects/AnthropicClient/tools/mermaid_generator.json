{
  "name": "MermaidDiagramGenerator",
  "description": "Generates Mermaid diagrams from structured descriptions of concepts and relationships",
  "input_schema": {
    "type": "object",
    "properties": {
      "concepts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "string"},
            "label": {"type": "string"},
            "style": {"type": "object", "optional": true}
          }
        }
      },
      "relationships": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "from": {"type": "string"},
            "to": {"type": "string"},
            "label": {"type": "string"},
            "type": {"type": "string", "enum": ["normal", "dotted", "thick"]}
          }
        }
      },
      "direction": {
        "type": "string",
        "enum": ["TD", "LR"]
      }
    },
    "required": ["concepts", "relationships", "direction"]
  }
}