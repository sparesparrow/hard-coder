{
    "client_server": {
      "name": "Client-Server Architecture",
      "pattern": "client_server",
      "description": "Traditional client-server architecture with clear separation of concerns",
      "components": [
        "client",
        "server",
        "database",
        "api"
      ],
      "example": "Web application with REST API"
    },
    "mvc": {
      "name": "Model-View-Controller",
      "pattern": "mvc",
      "description": "Separation of data, presentation, and control logic",
      "components": [
        "models",
        "views",
        "controllers",
        "services"
      ],
      "example": "CRUD application with UI"
    },
    "microservices": {
      "name": "Microservices Architecture",
      "pattern": "microservices",
      "description": "Distributed system with independent services",
      "components": [
        "gateway",
        "services",
        "message_broker",
        "database"
      ],
      "example": "E-commerce platform"
    },
    "event_driven": {
      "name": "Event-Driven Architecture",
      "pattern": "event_driven",
      "description": "System based on event production, detection, and reaction",
      "components": [
        "producers",
        "consumers",
        "event_bus",
        "handlers"
      ],
      "example": "Real-time analytics system"
    },
    "cqrs": {
      "name": "Command Query Responsibility Segregation",
      "pattern": "cqrs",
      "description": "Separates read and write operations for better scalability and performance",
      "components": [
        "command_handlers",
        "query_handlers",
        "event_store",
        "read_models",
        "write_models"
      ],
      "example": "High-performance trading platform"
    },
    "hexagonal": {
      "name": "Hexagonal Architecture (Ports and Adapters)",
      "pattern": "hexagonal",
      "description": "Isolates business logic from external concerns through ports and adapters",
      "components": [
        "domain",
        "application",
        "ports",
        "adapters",
        "infrastructure"
      ],
      "example": "Domain-driven design application"
    },
    "pipeline": {
      "name": "Pipeline Architecture",
      "pattern": "pipeline",
      "description": "Sequential processing of data through series of components",
      "components": [
        "input_handlers",
        "processors",
        "transformers",
        "output_handlers",
        "pipeline_manager"
      ],
      "example": "Data processing system"
    },
    "clean_architecture": {
      "name": "Clean Architecture",
      "pattern": "clean_architecture",
      "description": "Separation of concerns with dependency rule enforcement",
      "components": [
        "entities",
        "use_cases",
        "interface_adapters",
        "frameworks",
        "drivers"
      ],
      "example": "Enterprise business application"
    },
    "repository_pattern": {
      "name": "Repository Pattern",
      "pattern": "repository",
      "description": "Abstracts data persistence layer from business logic",
      "components": [
        "repositories",
        "entities",
        "data_mappers",
        "unit_of_work",
        "query_specifications"
      ],
      "example": "Data-centric application"
    },
    "saga": {
      "name": "Saga Pattern",
      "pattern": "saga",
      "description": "Manages distributed transactions and complex workflows",
      "components": [
        "saga_orchestrator",
        "compensating_actions",
        "local_transactions",
        "event_handlers",
        "state_tracker"
      ],
      "example": "Distributed transaction system"
    },
    "actor": {
      "name": "Actor Pattern",
      "pattern": "actor",
      "description": "Concurrent computation through independent actors",
      "components": [
        "actors",
        "mailboxes",
        "supervisors",
        "message_handlers",
        "router"
      ],
      "example": "Concurrent processing system"
    },
    "flux": {
      "name": "Flux Architecture",
      "pattern": "flux",
      "description": "Unidirectional data flow for user interface management",
      "components": [
        "dispatcher",
        "stores",
        "actions",
        "views",
        "action_creators"
      ],
      "example": "React-based web application"
    },
    "ddd": {
      "name": "Domain-Driven Design",
      "pattern": "ddd",
      "description": "Complex domain modeling with strategic and tactical patterns",
      "components": [
        "aggregates",
        "value_objects",
        "entities",
        "domain_services",
        "bounded_contexts"
      ],
      "example": "Complex business domain application"
    },
    "space_based": {
      "name": "Space-Based Architecture",
      "pattern": "space_based",
      "description": "High scalability through in-memory data grid",
      "components": [
        "processing_units",
        "virtual_middleware",
        "data_grid",
        "messaging_grid",
        "processing_grid"
      ],
      "example": "High-scale web application"
    },
    "lambda": {
      "name": "Lambda Architecture",
      "pattern": "lambda",
      "description": "Combines batch and stream processing",
      "components": [
        "batch_layer",
        "speed_layer",
        "serving_layer",
        "raw_data",
        "views"
      ],
      "example": "Big data processing system"
    }
  }